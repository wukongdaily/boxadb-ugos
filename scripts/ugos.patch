@@ -0,0 +1,280 @@
+package main
+
+// 安装包库：把用户上传的 apk / xapk / apkm 存进应用自己的 data 目录
+// （UGAPP_DATA_DIR/packages），之后局域网里任何设备都能直接选来装，不用重复上传。
+//
+// 为什么用它而不是只靠「可访问文件夹」授权：
+//   · data 目录是应用用户天然可读写的，不需要任何系统授权；
+//   · 不受「改完授权必须重置应用」的限制；
+//   · 卸载时随应用一起清掉，不会在用户存储里留垃圾。
+//
+// 端点：
+//   GET    /pkg/list              列表 + 剩余空间
+//   POST   /pkg/upload            multipart 字段 file，流式落盘
+//   GET    /pkg/file?name=        读取（供前端安装）
+//   POST   /pkg/delete?name=      删除
+//   POST   /pkg/purge             清空整个库
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"log"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"syscall"
+	"time"
+)
+
+const pkgMaxNameLen = 120
+
+func pkgDir() string {
+	d := filepath.Join(dataDir(), "packages")
+	_ = os.MkdirAll(d, 0o755)
+	return d
+}
+
+func pkgMaxBytes() int64 {
+	mb := 1024
+	if v := strings.TrimSpace(os.Getenv("BRIDGE_PKG_MAX_MB")); v != "" {
+		if n, err := fmt.Sscanf(v, "%d", &mb); n != 1 || err != nil {
+			mb = 1024
+		}
+	}
+	if mb <= 0 {
+		mb = 1024
+	}
+	return int64(mb) << 20
+}
+
+type pkgEntry struct {
+	Name  string `json:"name"`
+	Size  int64  `json:"size"`
+	MTime int64  `json:"mtime"`
+}
+
+// pkgSafeName 只保留纯文件名：拒绝路径分隔符、..、隐藏文件与非法扩展名
+func pkgSafeName(raw string) (string, bool) {
+	n := filepath.Base(strings.ReplaceAll(raw, "\\", "/"))
+	if n == "" || n == "." || n == ".." || n != raw {
+		return "", false
+	}
+	if strings.HasPrefix(n, ".") || strings.Contains(n, "/") || strings.Contains(n, "..") {
+		return "", false
+	}
+	n = strings.Map(func(r rune) rune {
+		switch {
+		case r == 0 || r < 0x20 || r == '/' || r == '\\' || r == ':' || r == '*' || r == '?' || r == '"' || r == '<' || r == '>' || r == '|':
+			return '_'
+		}
+		return r
+	}, n)
+	if len(n) > pkgMaxNameLen {
+		ext := filepath.Ext(n)
+		n = n[:pkgMaxNameLen-len(ext)] + ext
+	}
+	if !pkgExtOK[strings.ToLower(filepath.Ext(n))] {
+		return "", false
+	}
+	return n, true
+}
+
+var pkgExtOK = map[string]bool{".apk": true, ".xapk": true, ".apkm": true}
+
+// pkgFree 返回库所在分区的可用字节
+func pkgFree() int64 {
+	var st syscall.Statfs_t
+	if err := syscall.Statfs(dataDir(), &st); err != nil {
+		return -1
+	}
+	return int64(st.Bavail) * int64(st.Bsize)
+}
+
+func pkgList() []pkgEntry {
+	des, err := os.ReadDir(pkgDir())
+	if err != nil {
+		return nil
+	}
+	out := make([]pkgEntry, 0, len(des))
+	for _, de := range des {
+		if de.IsDir() {
+			continue
+		}
+		info, err := de.Info()
+		if err != nil {
+			continue
+		}
+		if !pkgExtOK[strings.ToLower(filepath.Ext(de.Name()))] {
+			continue
+		}
+		out = append(out, pkgEntry{Name: de.Name(), Size: info.Size(), MTime: info.ModTime().Unix()})
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].MTime == out[j].MTime {
+			return strings.ToLower(out[i].Name) < strings.ToLower(out[j].Name)
+		}
+		return out[i].MTime > out[j].MTime
+	})
+	return out
+}
+
+// pkgUniquePath 同名文件自动加序号，避免覆盖
+func pkgUniquePath(name string) string {
+	p := filepath.Join(pkgDir(), name)
+	if _, err := os.Stat(p); err != nil {
+		return p
+	}
+	ext := filepath.Ext(name)
+	stem := strings.TrimSuffix(name, ext)
+	for i := 1; i < 1000; i++ {
+		cand := filepath.Join(pkgDir(), fmt.Sprintf("%s-%d%s", stem, i, ext))
+		if _, err := os.Stat(cand); err != nil {
+			return cand
+		}
+	}
+	return p
+}
+
+func pkgJSON(w http.ResponseWriter, v any) {
+	w.Header().Set("Content-Type", "application/json; charset=utf-8")
+	_ = json.NewEncoder(w).Encode(v)
+}
+
+func handlePkgList(w http.ResponseWriter) {
+	items := pkgList()
+	var used int64
+	for _, it := range items {
+		used += it.Size
+	}
+	pkgJSON(w, map[string]any{"ok": true, "items": items, "used": used, "free": pkgFree(),
+		"maxMB": pkgMaxBytes() >> 20, "dir": pkgDir()})
+}
+
+func handlePkgUpload(w http.ResponseWriter, r *http.Request) {
+	max := pkgMaxBytes()
+	r.Body = http.MaxBytesReader(w, r.Body, max+(8<<20))
+	if err := r.ParseMultipartForm(8 << 20); err != nil {
+		pkgJSON(w, map[string]any{"ok": false, "message": "上传失败或文件过大（上限 " + fmt.Sprint(max>>20) + "MB）"})
+		return
+	}
+	defer r.MultipartForm.RemoveAll()
+	f, hdr, err := r.FormFile("file")
+	if err != nil {
+		pkgJSON(w, map[string]any{"ok": false, "message": "没有收到文件"})
+		return
+	}
+	defer f.Close()
+	name, ok := pkgSafeName(hdr.Filename)
+	if !ok {
+		pkgJSON(w, map[string]any{"ok": false, "message": "只支持 .apk / .xapk / .apkm"})
+		return
+	}
+	if free := pkgFree(); free >= 0 && free < hdr.Size+(64<<20) {
+		pkgJSON(w, map[string]any{"ok": false, "message": "存储空间不足"})
+		return
+	}
+	dst := pkgUniquePath(name)
+	tmp := dst + ".part"
+	out, err := os.OpenFile(tmp, os.O_CREATE|os.O_TRUNC|os.O_WRONLY, 0o644)
+	if err != nil {
+		pkgJSON(w, map[string]any{"ok": false, "message": "写入失败：" + err.Error()})
+		return
+	}
+	n, err := io.Copy(out, f)
+	if cerr := out.Close(); err == nil {
+		err = cerr
+	}
+	if err != nil {
+		_ = os.Remove(tmp)
+		pkgJSON(w, map[string]any{"ok": false, "message": "上传中断：" + err.Error()})
+		return
+	}
+	if err := os.Rename(tmp, dst); err != nil {
+		_ = os.Remove(tmp)
+		pkgJSON(w, map[string]any{"ok": false, "message": "保存失败：" + err.Error()})
+		return
+	}
+	final := filepath.Base(dst)
+	log.Printf("[pkg] 存入安装包库 %s (%d 字节)", final, n)
+	pkgJSON(w, map[string]any{"ok": true, "name": final, "size": n})
+}
+
+func handlePkgFile(w http.ResponseWriter, r *http.Request) {
+	name, ok := pkgSafeName(r.URL.Query().Get("name"))
+	if !ok {
+		http.Error(w, "文件名不合法", http.StatusForbidden)
+		return
+	}
+	p := filepath.Join(pkgDir(), name)
+	st, err := os.Stat(p)
+	if err != nil {
+		http.Error(w, "文件不存在", http.StatusNotFound)
+		return
+	}
+	f, err := os.Open(p)
+	if err != nil {
+		http.Error(w, "文件不可读", http.StatusForbidden)
+		return
+	}
+	defer f.Close()
+	w.Header().Set("Content-Type", "application/vnd.android.package-archive")
+	http.ServeContent(w, r, name, st.ModTime().Round(time.Second), f)
+}
+
+func handlePkgDelete(w http.ResponseWriter, r *http.Request) {
+	name, ok := pkgSafeName(r.URL.Query().Get("name"))
+	if !ok {
+		pkgJSON(w, map[string]any{"ok": false, "message": "文件名不合法"})
+		return
+	}
+	p := filepath.Join(pkgDir(), name)
+	if err := os.Remove(p); err != nil {
+		pkgJSON(w, map[string]any{"ok": false, "message": "删除失败：" + err.Error()})
+		return
+	}
+	log.Printf("[pkg] 从安装包库删除 %s", name)
+	pkgJSON(w, map[string]any{"ok": true, "name": name})
+}
+
+func handlePkgPurge(w http.ResponseWriter) {
+	n := 0
+	for _, it := range pkgList() {
+		if err := os.Remove(filepath.Join(pkgDir(), it.Name)); err == nil {
+			n++
+		}
+	}
+	pkgJSON(w, map[string]any{"ok": true, "removed": n})
+}
+
+func handlePkg(w http.ResponseWriter, r *http.Request) bool {
+	switch r.URL.Path {
+	case "/pkg/list":
+		handlePkgList(w)
+	case "/pkg/upload":
+		if r.Method != http.MethodPost {
+			http.Error(w, "method", http.StatusMethodNotAllowed)
+			return true
+		}
+		handlePkgUpload(w, r)
+	case "/pkg/file":
+		handlePkgFile(w, r)
+	case "/pkg/delete":
+		if r.Method != http.MethodPost {
+			http.Error(w, "method", http.StatusMethodNotAllowed)
+			return true
+		}
+		handlePkgDelete(w, r)
+	case "/pkg/purge":
+		if r.Method != http.MethodPost {
+			http.Error(w, "method", http.StatusMethodNotAllowed)
+			return true
+		}
+		handlePkgPurge(w)
+	default:
+		return false
+	}
+	return true
+}
